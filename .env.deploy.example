# Credenciais do FTP do InfinityFree, usadas por tools/deploy-infinityfree.py.
#
# Copie este arquivo para .env.deploy (que o git ignora) e preencha com os
# dados de "FTP Details" no painel da conta. Nada aqui entra no repositório.

FTP_HOST=
FTP_USERNAME=
FTP_PASSWORD=
FTP_PORT=21

# Diretório que a conta serve como raiz do site.
FTP_DIR=htdocs
