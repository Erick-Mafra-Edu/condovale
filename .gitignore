# Regras do repositório inteiro.
#
# O backend Laravel fica em /laravel e tem o próprio .gitignore, que cobre
# vendor, storage, cache e todos os arquivos .env — inclusive o .env.production,
# com as credenciais do host compartilhado. Essas regras não são repetidas aqui
# para não existirem duas fontes de verdade.
# (O bloco antigo apontava para /backend/, diretório que não existe.)

# Nuxt — dependências, artefatos de build e configuração local
/frontend/node_modules/
/frontend/.nuxt/
/frontend/.output/
/frontend/.data/
/frontend/.cache/
/frontend/dist/
/frontend/coverage/
/frontend/.vercel/
/frontend/.netlify/
/frontend/.env
/frontend/.env.*
!/frontend/.env.example
/frontend/npm-debug.log*
/frontend/yarn-debug.log*
/frontend/yarn-error.log*
/frontend/pnpm-debug.log*

# Artefatos temporários de validação visual local
/frontend/.tmp-*
/frontend/*-liquid-glass.png

# Python — cache de bytecode gerado ao importar os scripts de publicação
__pycache__/
*.pyc

# Publicação no InfinityFree — credenciais de FTP e estado do último envio
.env.deploy
/tools/.deploy-state.json
/tools/.deploy-progress.txt

# Configuração de outros agentes
AGENTS.MD
.codex/*
