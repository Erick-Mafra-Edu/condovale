# Laravel — regras restritas ao backend
/backend/.env
/backend/.env.*
!/backend/.env.example
/backend/vendor/
/backend/node_modules/
/backend/public/build/
/backend/public/hot
/backend/public/storage
/backend/bootstrap/cache/*.php
!/backend/bootstrap/cache/.gitignore
/backend/storage/*.key
/backend/storage/pail/
/backend/storage/logs/*
!/backend/storage/logs/.gitignore
/backend/storage/framework/cache/*
!/backend/storage/framework/cache/.gitignore
/backend/storage/framework/sessions/*
!/backend/storage/framework/sessions/.gitignore
/backend/storage/framework/testing/*
!/backend/storage/framework/testing/.gitignore
/backend/storage/framework/views/*
!/backend/storage/framework/views/.gitignore
/backend/.phpunit.result.cache
/backend/.phpactor.json
/backend/auth.json
/backend/Homestead.yaml
/backend/Homestead.json
/backend/.vagrant/

# Nuxt — dependências, artefatos de build e configuração local
/frontend/node_modules/
/frontend/.nuxt/
/frontend/.output/
/frontend/.data/
/frontend/.cache/
/frontend/dist/
/frontend/coverage/
/frontend/.vercel/
/frontend/.netlify/
/frontend/.env
/frontend/.env.*
!/frontend/.env.example
/frontend/npm-debug.log*
/frontend/yarn-debug.log*
/frontend/yarn-error.log*
/frontend/pnpm-debug.log*

# Artefatos temporários de validação visual local
/frontend/.tmp-*
/frontend/*-liquid-glass.png
AGENTS.MD
.codex/*