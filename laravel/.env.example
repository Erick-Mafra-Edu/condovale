# Ambiente de DESENVOLVIMENTO local.
#
# Este é o arquivo que o Laravel carrega por padrão, então `php artisan serve`
# sobe direto com SQLite e sem nenhum serviço externo.
#
# Em produção o servidor define APP_ENV antes de a aplicação subir (o .htaccess
# da raiz faz isso com SetEnv) e o Laravel passa a carregar .env.production,
# com o MySQL e o domínio do InfinityFree. Para conferir aquela configuração a
# partir daqui: php artisan --env=production about

APP_NAME=CondoVale
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=America/Sao_Paulo
APP_URL=http://localhost:8000

APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_BR

APP_MAINTENANCE_DRIVER=file

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12
# RNF02 — senhas exclusivamente com Argon2id.
HASH_DRIVER=argon2id

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# SQLite não exige servidor; o arquivo fica em database/database.sqlite.
# Para usar o PostgreSQL da arquitetura oficial, habilite pdo_pgsql e troque:
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=condovale
# DB_USERNAME=postgres
# DB_PASSWORD=
DB_CONNECTION=sqlite

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SAME_SITE=lax
# Sem HTTPS no ambiente local o cookie não pode ser marcado como secure.
SESSION_SECURE_COOKIE=false

# Origens do frontend Nuxt autorizadas a enviar o cookie de sessão.
CORS_ALLOWED_ORIGINS="http://localhost:3000,http://127.0.0.1:3000"

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MAIL_MAILER=log
MAIL_FROM_ADDRESS="nao-responda@condovale.local"
MAIL_FROM_NAME="${APP_NAME}"

# --- Implantação remota -------------------------------------------------
# A rota POST /api/deploy/migrate roda migrate:fresh --seed pelo HTTP, porque
# nem todo host da acesso a linha de comando.
# Ela DERRUBA TODAS AS TABELAS. Gere o token com: php -r "echo bin2hex(random_bytes(32));"
DEPLOY_ENABLED=false
DEPLOY_TOKEN=
DEPLOY_TIMEOUT=300
