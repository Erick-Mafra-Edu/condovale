# Arquivo usado apenas no host compartilhado (InfinityFree), onde o projeto
# inteiro fica na raiz da conta e o document root não aponta para public/.
# Localmente o `php artisan serve` não lê este arquivo.

# Identifica o ambiente ANTES de a aplicação subir. O arquivo enviado para o
# servidor se chama .env (e já traz APP_ENV=production dentro), então o Laravel
# procura .env.production, não encontra e cai no .env — o site sobe mesmo se o
# mod_env estiver desabilitado.
<IfModule mod_env.c>
SetEnv APP_ENV production
</IfModule>

# Impede o acesso direto a arquivos ocultos (.env, .env.production, .git...).
<Files .*>
<IfModule !mod_authz_core.c>
Order deny,allow
Deny from all
</IfModule>
<IfModule mod_authz_core.c>
Require all denied
</IfModule>
</Files>

# Encaminha tudo para o front controller dentro de public/.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{REQUEST_URI} !^/public/
RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
